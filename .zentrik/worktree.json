{
  "version": 1,
  "id": "zentrik-open-crm",
  "defaultBase": "origin/develop",
  "branchPrefixFile": ".agent-branch-prefix",
  "localState": [],
  "ports": {
    "primary": {
      "frontend": 5177
    },
    "worktreeBands": {
      "frontend": 5200
    }
  },
  "environment": {
    "NODE_ENV": "development",
    "ZENTRIK_OPEN_CRM_ENVIRONMENT": "sandbox"
  },
  "runtime": {
    "command": ["node", "scripts/worktree-dev.mjs"],
    "defaultProfile": "sandbox",
    "profiles": {
      "sandbox": {
        "description": "Open CRM Vite sandbox on a stable worktree port"
      }
    }
  }
}
