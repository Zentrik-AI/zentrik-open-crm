{
  "name": "zentrik-open-crm",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Open-source, local-first CRM that people and coding agents work together: source-grounded accounts, a crm command and MCP server, and a review gate for every agent change.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zentrik-AI/zentrik-open-crm.git"
  },
  "bugs": {
    "url": "https://github.com/Zentrik-AI/zentrik-open-crm/issues"
  },
  "homepage": "https://github.com/Zentrik-AI/zentrik-open-crm#readme",
  "keywords": [
    "crm",
    "open-source",
    "local-first",
    "agentic-crm",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "zentrik"
  ],
  "bin": {
    "open-crm": "bin/open-crm.js"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "crm": "node bin/open-crm.js",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
