{
  "name": "zentrik-open-crm",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Open-source, local-first CRM that people and their coding agents work together: every fact shows its source, agents propose and people approve, and what several accounts are saying is handed on as product evidence.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zentrik-AI/zentrik-open-crm.git"
  },
  "bugs": {
    "url": "https://github.com/Zentrik-AI/zentrik-open-crm/issues"
  },
  "homepage": "https://github.com/Zentrik-AI/zentrik-open-crm#readme",
  "keywords": [
    "crm",
    "open-source",
    "local-first",
    "agentic-crm",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "zentrik"
  ],
  "bin": {
    "open-crm": "dist/runtime/bin/open-crm.js"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "dist",
    "docs",
    "assets/brand",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "TRADEMARKS.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/third-party-notices.mjs --check && tsc --noEmit && vite build && npm run build:cli && node scripts/third-party-notices.mjs --dist",
    "notices": "node scripts/third-party-notices.mjs",
    "build:cli": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --moduleDetection force --strict --esModuleInterop --skipLibCheck --allowJs --rewriteRelativeImportExtensions --rootDir . --outDir dist/runtime bin/open-crm.js",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "preview": "vite preview",
    "crm": "node bin/open-crm.js",
    "test": "node --test \"tests/unit/*.test.ts\" \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
